        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "timesteps_s": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "finish_reason": {
