      }
    },
    "viewpoint": {
      "enum": [
        "first_person",
        "third_person",
        null
      ]
    },
    "performance_review": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_task_name": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Broad task category such as object_cleaning or hair_styling; preserves task_name."
    },
    "common_task": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Unified task grouping name; preserves the original task_name."
    },
    "task_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100
