              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "office"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "professional_work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "classroom"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "professional_work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "laboratory"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "professional_work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "healthcare_facility"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "professional_work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "conference_center"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "professional_work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "park_garden"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "street"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "public_facility"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
