{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanCOIN annotation standard 2",
  "description": "Final normalized annotation, not raw model output. Scene and action taxonomies are open vocabulary.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_dir": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "timesteps_s": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "scene": {
      "type": [
        "string",
        "null"
      ]
    },
    "subtask": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subtask"
      }
    },
    "task_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/key_event"
      }
    },
    "state_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state_change"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "scene_graph": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene_graph"
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recovery"
      }
    },
    "instruction_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data_issue"
      }
    },
    "viewpoint": {
      "enum": [
        "first_person",
        "third_person",
        null
      ]
    },
    "performance_review": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_task_name": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Broad task category such as object_cleaning or hair_styling; preserves task_name."
    },
    "common_task": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Unified task grouping name; preserves the original task_name."
    },
    "task_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?:wipe|open|fold|arrange|throw|remove|close|organize|pour|hang|unfold|collect|clean|stack|insert|cover|cut|tear|install|spray|rinse|secure|wrap|tighten|tie|seal|sweep|unscrew|attach|sort|stick|screw|disassemble|coil|wash|assemble|connect|check|dry|thread|replace|untie|peel|rearrange|apply|button|untangle|scrape|reassemble|separate|scoop|scrub|write|wind|crumple|bind|draw|unzip|staple|zip|erase|cap|fill|unplug|test|stamp|slice|wring|loosen|stir|drape|discard|tuck|unwrap|trim|punch|load|reattach|detach|divide|scan|unroll|plug|disconnect|pry|tape|wet|reinsert|switch|clamp|brush|pair|dice|dispense|pack|polish|sew|soak|uncap) [a-z]+(?:[ -][a-z]+)*$",
      "description": "Canonical Subtask verb plus normalized principal object name; null when not supported."
    },
    "actions": {
      "type": "object",
      "properties": {
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "vocabulary"
      ],
      "additionalProperties": false
    },
    "scene_classification": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "household",
            "industrial_production",
            "commercial_service",
            "professional_work",
            "public_space",
            "other"
          ]
        },
        "area": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "not": {
            "enum": [
              "meeting_room",
              "badminton_court",
              "sports_equipment_area",
              "food_service_area",
              "dressing_area",
              "home_fitness_area",
              "home_recreation_area",
              "pet_care_area",
              "shoe_care_area",
              "unknown",
              "massage_room"
            ]
          }
        },
        "original_description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "area",
        "original_description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          },
          "then": {
            "properties": {
              "area": {
                "enum": [
                  "kitchen",
                  "living_room",
                  "dining_room",
                  "bedroom",
                  "study_room",
                  "bathroom",
                  "storage_room",
                  "laundry_area",
                  "balcony"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          },
          "then": {
            "properties": {
              "area": {
                "enum": [
                  "factory_workshop",
                  "workroom",
                  "industrial_warehouse",
                  "equipment_room",
                  "testing_lab",
                  "construction_site"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "professional_work"
              }
            }
          },
          "then": {
            "properties": {
              "area": {
                "enum": [
                  "office",
                  "classroom",
                  "laboratory",
                  "healthcare_facility",
                  "conference_center"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
          },
          "then": {
            "properties": {
              "area": {
                "enum": [
                  "park_garden",
                  "street",
                  "public_facility",
                  "transportation",
                  "farm",
                  "sports_area",
                  "indoor_sports_venue"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "other"
              }
            }
          },
          "then": {
            "properties": {
              "area": {
                "enum": [
                  "other"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "kitchen"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "living_room"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "dining_room"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "bedroom"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "study_room"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "bathroom"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "storage_room"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "laundry_area"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "balcony"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "household"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "factory_workshop"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "workroom"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "industrial_warehouse"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "equipment_room"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "testing_lab"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "construction_site"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "industrial_production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "retail_store"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "restaurant"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "beverage_shop"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "logistics_facility"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "hotel"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "hair_salon"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "beauty_salon"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "commercial_service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
