                "const": "transportation"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "farm"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
