                "const": "indoor_sports_venue"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "public_space"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "area": {
                "const": "other"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "other"
              }
            }
          }
        }
      ]
    },
    "capture_context": {
      "type": "object"
    },
    "operator_mistakes": {
      "type": "array",
