  "atomic_actions": [
    {
      "verb": "approach",
      "zh": "接近",
      "definition": "手或操作端向目标靠近"
    },
    {
      "verb": "align",
      "zh": "对准",
      "definition": "调整相对位置或姿态，使目标对齐"
    },
    {
      "verb": "grasp",
      "zh": "抓取",
      "definition": "建立手与目标的抓握关系"
    },
    {
      "verb": "secure",
      "zh": "稳定保持",
      "definition": "稳定保持已有抓握或约束"
    },
    {
      "verb": "lift",
      "zh": "抬起",
      "definition": "使被操纵物体向上移动"
    },
    {
      "verb": "lower",
      "zh": "放低",
      "definition": "使被操纵物体向下移动"
    },
    {
      "verb": "release",
      "zh": "释放",
      "definition": "解除抓握或持有关系"
    },
    {
      "verb": "press",
      "zh": "按压",
      "definition": "对目标施加压向接触面的作用"
    },
    {
      "verb": "push",
      "zh": "推动",
      "definition": "施力使目标向远离施力者方向移动"
    },
    {
      "verb": "pull",
      "zh": "拉动",
      "definition": "施力使目标向施力者方向移动"
    },
    {
      "verb": "rotate",
      "zh": "旋转",
      "definition": "使目标绕轴发生角度变化"
    },
    {
      "verb": "tilt",
      "zh": "倾斜",
      "definition": "使目标偏离原有竖直或水平姿态"
    },
    {
      "verb": "slide",
      "zh": "滑动",
      "definition": "保持接触并沿表面相对移动"
    },
    {
      "verb": "insert",
      "zh": "插入",
      "definition": "使对象沿入口或约束通道进入"
    },
    {
      "verb": "shake",
      "zh": "摇晃",
      "definition": "执行往复振荡运动"
    },
    {
      "verb": "strike",
      "zh": "敲击",
      "definition": "执行短时冲击接触"
    },
    {
      "verb": "scrub",
      "zh": "擦洗",
      "definition": "在接触条件下反复摩擦目标表面"
    },
    {
      "verb": "retreat",
      "zh": "撤离",
      "definition": "操作端离开目标区域"
    }
  ],
